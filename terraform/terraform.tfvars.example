# =============================================================================
# Production Environment Configuration Template (terraform.tfvars.example)
# Copy this file to `terraform.tfvars` and customize for your deployment.
# =============================================================================

# --- Project & Environment Metadata ---
project_name = "storage-gw"
environment  = "prod"

tags = {
  Environment = "prod"
  CostCenter  = "infrastructure"
  ManagedBy   = "terraform"
}

gcp_labels = {
  environment = "prod"
  managed-by  = "terraform"
}

# --- GCP Simulated On-Premise Environment ---
gcp_project                 = "encoded-alpha-457108-e8"
gcp_region                  = "us-central1"
gcp_zone                    = "us-central1-a"
gcp_vpc_name                = "source-vpc"
source_vpc_ip_cidr_range    = ["10.10.1.0/24"]
gcp_vm_name                 = "source-vm"
gcp_vm_machine_type         = "e2-medium"
gcp_vm_deletion_protection  = false
gcp_allowed_ssh_cidrs       = ["0.0.0.0/0"] # Restrict to corporate bastion/VPN in production

# --- AWS VPC & Subnets ---
aws_region             = "us-east-1"
aws_vpc_name           = "vpc"
aws_vpc_cidr           = "10.0.0.0/16"
azs                    = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnets         = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnets        = ["10.0.4.0/24", "10.0.5.0/24", "10.0.6.0/24"]
database_subnets       = []
enable_nat_gateway     = true
single_nat_gateway     = true  # Set to false with one_nat_gateway_per_az = true for multi-AZ HA
one_nat_gateway_per_az = false

# --- Cross-Cloud HA VPN & Dynamic BGP Routing ---
aws_bgp_asn                   = 64512
gcp_bgp_asn                   = 64514
bgp_advertised_route_priority = 100

vpn_tunnel_inside_cidrs = {
  "0-1" = "169.254.10.0/30"
  "0-2" = "169.254.10.4/30"
  "1-1" = "169.254.11.0/30"
  "1-2" = "169.254.11.4/30"
}

# --- AWS Storage Gateway Appliance & EC2 Host ---
gateway_name          = "gcp-vm-file-gateway"
gateway_instance_name = "gateway-instance"
gateway_timezone      = "GMT"
gateway_type          = "FILE_S3"
gateway_instance_type = "m5.xlarge" # Minimum 4 vCPUs / 16 GiB RAM recommended
key_name              = null

# EBS Local Cache (Minimum 150 GiB required by AWS)
cache_disk_size        = 150
cache_disk_type        = "gp3"
cache_disk_iops        = 3000
cache_disk_throughput  = 125
cache_disk_encrypted   = true
cache_disk_kms_key_arn = null

# Optional: Pre-activate gateway if known; if null, retrieved automatically across VPN
activation_key = null

# --- Amazon S3 Target Bucket ---
s3_bucket_name             = "gcp-simulated-storage-gateway-bucket"
s3_force_destroy           = false # Keep false in production to prevent accidental data deletion
s3_versioning_enabled      = "Enabled"
enable_least_privilege_iam = true  # Replaces AmazonS3FullAccess with scoped bucket policy

# --- SMB File Share Settings ---
smb_guest_password   = "GuestPass123!" # Change to a strong production secret
smb_authentication   = "GuestAccess"   # Options: GuestAccess, ActiveDirectory
smb_read_only        = false
smb_guess_mime_type  = true
smb_case_sensitivity = "ClientSpecified"
smb_file_share_name  = null # Defaults to s3_bucket_name if null
smb_admin_users      = []
smb_valid_users      = []
smb_invalid_users    = []

